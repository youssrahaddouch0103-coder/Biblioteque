<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bibliotech.EmpruntsController">

    <!-- Titre et filtres -->
    <top>
        <VBox spacing="10" style="-fx-background-color: white;">
            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>

            <!-- Barre de filtres -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #011753;" text="Filtres:">
                    <font>
                        <Font size="16.0" />
                    </font></Label>

                <Label style="-fx-text-fill: #011753;" text="Rechercher:">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font></Label>
                <TextField fx:id="searchField" prefWidth="250" promptText="Livre, adhérent, ID..." style="-fx-background-color: white; -fx-border-color: #B0A69D;" />

                <Label style="-fx-text-fill: #011753;" text="Statut:">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font></Label>
                <ComboBox fx:id="statusFilterCombo" prefWidth="120" />

                <Button onAction="#onRefresh" style="-fx-background-color: #1b531e; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Rafraîchir" />

                <Label fx:id="statusLabel" style="-fx-font-weight: bold; -fx-text-fill: #331a00;" />
            </HBox>
        </VBox>
    </top>

    <!-- Tableau des emprunts -->
    <center>
        <TableView fx:id="loansTable" style="-fx-background-color: #ffffff; -fx-border-color: #B0A69D; -fx-border-width: 2;">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50" text="ID" />
                <TableColumn fx:id="colBook" prefWidth="220" text="Livre" />
                <TableColumn fx:id="colMember" prefWidth="180" text="Adhérent" />
                <TableColumn fx:id="colLoanDate" prefWidth="110" text="Date emprunt" />
                <TableColumn fx:id="colDueDate" prefWidth="110" text="Date retour" />
                <TableColumn fx:id="colReturnDate" prefWidth="110" text="Date rendu" />
                <TableColumn fx:id="colStatus" prefWidth="100" text="Statut" />
                <!-- NOUVELLE COLONNE ACTION -->
                <TableColumn fx:id="colAction" prefWidth="100" text="Action" />
            </columns>
            <BorderPane.margin>
                <Insets left="20.0" right="20.0" />
            </BorderPane.margin>
        </TableView>
    </center>

    <!-- Formulaire et actions -->
    <bottom>
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20;">

            <!-- Section 1 : Actions sur les emprunts sélectionnés -->
            <VBox spacing="10" style="-fx-background-color: #E8F4EA; -fx-padding: 15; -fx-border-color: #B0A69D; -fx-border-width: 1;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Actions sur l'emprunt sélectionné" textFill="#001755">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <HBox spacing="10">
                    <Button onAction="#onMarkReturned" style="-fx-background-color: #2E8B57; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;" text="Marquer comme rendu">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Button>
                </HBox>
            </VBox>

            <!-- Section 2 : Actions Admin (Suppression) -->
            <VBox spacing="10" style="-fx-background-color: #FFE8E8; -fx-padding: 15; -fx-border-color: #B0A69D; -fx-border-width: 1;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Actions Administrateur" textFill="#8B0000">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Supprimer l'adhérent (ID):" textFill="#8B0000">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                    <TextField fx:id="adminMemberIdField" prefWidth="100" promptText="ID adhérent" style="-fx-background-color: white; -fx-border-color: #B0A69D;" />
                    <Button onAction="#onDeleteMemberWithLoans" style="-fx-background-color: #8B0000; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand;" text="Supprimer Adhérent et ses emprunts">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Button>
                </HBox>

                <Label style="-fx-font-size: 12px; -fx-text-fill: #8B0000;" text="ATTENTION: Cette action supprime l'adhérent, tous ses emprunts et réservations. Irréversible !" />
            </VBox>
        </VBox>
    </bottom>
</BorderPane>