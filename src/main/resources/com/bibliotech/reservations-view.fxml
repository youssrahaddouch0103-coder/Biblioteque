<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #8E7C68;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bibliotech.ReservationsController">

    <top>
        <VBox spacing="10" style="-fx-background-color: white;">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label style="-fx-text-fill: #778086; -fx-font-weight: bold;" text="Filtres:">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font></Label>

                <Label style="-fx-text-fill: #778086;" text="Rechercher:">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font></Label>
                <TextField fx:id="searchField" prefWidth="250" promptText="Livre, adhérent, statut..." style="-fx-background-color: white; -fx-border-color: #B0A69D;" />

                <Label style="-fx-text-fill: #778086;" text="Statut:">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font></Label>
                <ComboBox fx:id="statusFilterCombo" prefWidth="120" />

                <Button onAction="#onRefresh" style="-fx-background-color: #005711; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Rafraîchir" textFill="WHITE" />

                <Label fx:id="statusLabel" style="-fx-font-weight: bold; -fx-text-fill: white;" />
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="reservationsTable" style="-fx-background-color: white; -fx-border-color: #B0A69D; -fx-border-width: 2;">
            <columns>
                <TableColumn fx:id="colId" prefWidth="50" text="ID" />
                <TableColumn fx:id="colBook" prefWidth="250" text="Livre" />
                <TableColumn fx:id="colMember" prefWidth="180" text="Adhérent" />
                <TableColumn fx:id="colDate" prefWidth="120" text="Date" />
                <TableColumn fx:id="colStatus" prefWidth="120" text="Statut" />
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 15;">
            <Label style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #778086;" text="Actions sur les réservations" textFill="#778086" />

            <VBox spacing="8" style="-fx-background-color: #cdd4d9; -fx-padding: 15; -fx-border-color: #B0A69D; -fx-border-width: 1;">
                <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Créer une nouvelle réservation" textFill="#001055">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font></Label>

                <GridPane hgap="10" vgap="8">
                    <Label text="ID Livre :" textFill="#001055" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                    <TextField fx:id="bookIdField" prefWidth="150" promptText="ID du livre" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="ID Adhérent :" textFill="#001055" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                    <TextField fx:id="memberIdField" prefWidth="150" promptText="ID de l'adhérent" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" />
                        <ColumnConstraints />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>

                <Button onAction="#onCreateReservation" style="-fx-background-color: #001055; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;" text="Créer la réservation">
                    <font>
                        <Font name="System Bold" size="12.0" />
                    </font>
                </Button>
            </VBox>
        </VBox>
    </bottom>
</BorderPane>
