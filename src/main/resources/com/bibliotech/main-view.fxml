<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: #8E7C68;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bibliotech.MainController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="10" style="-fx-background-color: #cdd2d9;">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Label maxWidth="-Infinity" minWidth="-Infinity" prefHeight="30.0" prefWidth="380.0" text="Biblioteque - Panneau d'administration">
                <font>
                    <Font name="System Bold Italic" size="20.0" />
                </font>
            </Label>

            <Pane HBox.hgrow="ALWAYS" />

            <Button onAction="#onLogout" style="-fx-background-color: #112267; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Déconnexion">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font>
            </Button>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="200.0" spacing="10" style="-fx-background-color: #cdd2d9;">
            <padding>
                <Insets bottom="15" left="10" right="10" top="15" />
            </padding>

            <Label style="-fx-text-fill: #011753; -fx-font-size: 13px; -fx-font-weight: bold;" text="Navigation" textFill="#cdd2d9" />

            <Button maxWidth="Infinity" onAction="#onDashboardClicked" style="-fx-background-color: #011753; -fx-text-fill: white; -fx-cursor: hand;" text="Tableau de bord" textFill="WHITE">
                <font>
                    <Font name="Times New Roman Bold Italic" size="14.0" />
                </font>
            </Button>

            <Separator />

            <Button maxWidth="Infinity" onAction="#onCatalogueClicked" style="-fx-background-color: transparent; -fx-text-fill: #011753; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-font-weight: bold;" text="Gérer les livres">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font></Button>

            <Button maxWidth="Infinity" onAction="#onEmpruntsClicked" style="-fx-background-color: transparent; -fx-text-fill: #011753; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-font-weight: bold;" text="Gérer les emprunts">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font></Button>

            <Button maxWidth="Infinity" onAction="#onAdherentsClicked" style="-fx-background-color: transparent; -fx-text-fill: #011753; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-font-weight: bold;" text="Gérer les adhérents">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font></Button>

            <Button maxWidth="Infinity" onAction="#onReservationsClicked" style="-fx-background-color: transparent; -fx-text-fill: #011753; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-font-weight: bold;" text="Voir les réservations">
                <font>
                    <Font name="System Bold" size="14.0" />
                </font></Button>
            <Button onAction="#onChangeAdminPassword" style="-fx-background-color: #8d0303; -fx-font-weight: bold; -fx-cursor: hand;" styleClass="secondary-button" text="Changer mot de passe admin" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font></Button>


        </VBox>
    </left>

    <center>
        <BorderPane fx:id="contentArea" style="-fx-background-color: #ffffff; -fx-border-color: #80621e;">
            <center>
                <Label text="Chargement..." />
            </center>
        </BorderPane>
    </center>

</BorderPane>
